define sensor         HASH("StructureGasSensor")
define display        HASH("ModularDeviceLEDdisplay2")
define button         HASH("ModularDeviceUtilityButton2x2")
define pipeAnalyzer   HASH("StructurePipeAnalysizer")
define displayName    HASH("DISPLAY")
define heatName       HASH("HEATING")
define coolName       HASH("COOLING")
define pipeName       HASH("HEATING_PIPE")
define pipeHeater     HASH("StructurePipeHeater")
define pump           HASH("StructureVolumePump")
define turboPump      HASH("StructureTurboVolumePump")
define activeVent     HASH("StructureActiveVent")
define largeVent      HASH("StructurePoweredVentLarge")
define airConditioner HASH("StructureAirConditioner")
define upName   HASH("+")
define downName HASH("-")
define minTemp  10
define maxTemp  35
define kelvin   273.15
define showTime 4
define pressLock 2
define enableHeating 1
define enableCooling 1
define pipeMaxK 1273.15
define pipeResetK 1173.15
alias target   r0
alias curr     r1
alias timer    r2
alias upLock   r3
alias downLock r4
alias tmp      r5
alias hyst     r6
alias heatOn   r7
alias coolOn   r8
alias pipeSafe r9
init:
    move target 22
    move hyst 1.0
    move pipeSafe 1
    sbn display displayName On 1
    sbn display displayName Mode 0
    add tmp maxTemp kelvin
    sbn airConditioner heatName On 1
    sbn airConditioner heatName Setting tmp
    add tmp minTemp kelvin
    sbn airConditioner coolName On 1
    sbn airConditioner coolName Setting tmp
main:
    lb curr sensor Temperature Average
    sub curr curr kelvin
    sub upLock upLock 1
    sub downLock downLock 1
    lbn tmp button upName Activate Sum
    blt tmp 0.5 upReleased
    move timer showTime
    bgt upLock 0 noUp
        add target target 1
        move upLock pressLock
    j noUp
upReleased:
    move upLock 0
noUp:
    lbn tmp button downName Activate Sum
    blt tmp 0.5 downReleased
    move timer showTime
    bgt downLock 0 noDown
        sub target target 1
        move downLock pressLock
    j noDown
downReleased:
    move downLock 0
noDown:
    max target target minTemp
    min target target maxTemp

show:
    bgt timer 0 showTarget
    round tmp curr
    sbn display displayName Setting tmp
    j control

showTarget:
    round tmp target
    sbn display displayName Setting tmp
    sub timer timer 1
control:
    move heatOn 0
    move coolOn 0
    sub tmp target hyst
    blt curr tmp doHeat
    add tmp target hyst
    bgt curr tmp doCool
    j writeOutputs

doHeat:
    move heatOn enableHeating
    j writeOutputs
doCool:
    move coolOn enableCooling
writeOutputs:
    lbn tmp pipeAnalyzer pipeName Temperature Average
    bgt tmp pipeMaxK pipeHot
    blt tmp pipeResetK pipeCool
    j pipeWrite
pipeHot:
    move pipeSafe 0
    j pipeWrite
pipeCool:
    move pipeSafe 1
pipeWrite:
    mul tmp heatOn pipeSafe
    sbn pipeHeater heatName On tmp
    sbn pump heatName On tmp
    sbn turboPump heatName On tmp
    sbn activeVent heatName On tmp
    sbn largeVent heatName On tmp
    sbn airConditioner heatName Mode tmp
    sbn pump coolName On coolOn
    sbn turboPump coolName On coolOn
    sbn activeVent coolName On coolOn
    sbn largeVent coolName On coolOn
    sbn airConditioner coolName Mode coolOn
end:
    yield
    j main
