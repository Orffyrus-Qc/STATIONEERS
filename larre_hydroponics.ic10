# LArRE hydroponics patrol
# Hookup:
#   No device pins used.
#   Rename the LArRE Dock (Hydroponics) to match LARRE_NAME below.
#
# Configure the station range below. The dock station is usually 0.
# LArRE will visit every station in the range, inspect the tray below,
# then activate the claw only when useful:
#   - empty tray: plant if LArRE is carrying seeds
#   - mature or seeding plant: harvest
#   - damaged/dead plant: clear it

alias rStation r0
alias rIdle r1
alias rError r2
alias rOccupied r3
alias rMature r4
alias rSeeding r5
alias rDamage r6
alias rShouldAct r7

define LARRE_TYPE HASH("StructureLarreDockHydroponics")
define LARRE_NAME HASH("Station")
define FIRST_STATION 0
define LAST_STATION 5
define SAMPLE_SLOT 255
define ACTION_SETTLE_SECONDS 2
define LOOP_PAUSE_SECONDS 10

init:
sbn LARRE_TYPE LARRE_NAME On 1
sbn LARRE_TYPE LARRE_NAME Activate 0
move rStation FIRST_STATION

main:
sbn LARRE_TYPE LARRE_NAME Setting rStation
jal waitForLarry
jal inspectTray
beqz rShouldAct nextStation
jal pulseClaw
sleep ACTION_SETTLE_SECONDS
jal waitForLarry

nextStation:
add rStation rStation 1
ble rStation LAST_STATION main
move rStation FIRST_STATION
sleep LOOP_PAUSE_SECONDS
j main

waitForLarry:
yield
lbn rError LARRE_TYPE LARRE_NAME Error Maximum
bnez rError waitForClear
lbn rIdle LARRE_TYPE LARRE_NAME Idle Maximum
beqz rIdle waitForLarry
j ra

waitForClear:
sbn LARRE_TYPE LARRE_NAME Activate 0
yield
lbn rError LARRE_TYPE LARRE_NAME Error Maximum
bnez rError waitForClear
j waitForLarry

inspectTray:
move rShouldAct 0
lbns rOccupied LARRE_TYPE LARRE_NAME SAMPLE_SLOT Occupied Maximum
beqz rOccupied markAction
lbns rDamage LARRE_TYPE LARRE_NAME SAMPLE_SLOT Damage Maximum
bge rDamage 1 markAction
lbns rMature LARRE_TYPE LARRE_NAME SAMPLE_SLOT Mature Maximum
bnez rMature markAction
lbns rSeeding LARRE_TYPE LARRE_NAME SAMPLE_SLOT Seeding Maximum
bgt rSeeding 0 markAction
j ra

markAction:
move rShouldAct 1
j ra

pulseClaw:
sbn LARRE_TYPE LARRE_NAME Activate 1
yield
sbn LARRE_TYPE LARRE_NAME Activate 0
j ra
