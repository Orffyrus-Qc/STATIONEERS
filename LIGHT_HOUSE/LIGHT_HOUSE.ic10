define lightType HASH("StructureLightLongWide")
define switchName HASH("LIGHTHOUSE_SWITCH")
define switchType HASH("StructureLogicSwitch2")
define leverType HASH("StructureLogicSwitch")
define LightCount 20
define BeamWidth 3
define StepDelay 0.3

alias switchPin d0
alias nameIndex r0
alias lightState r1
alias phase r2
alias offIndex r3
alias switchState r4
alias leverState r5
alias systemOn r6
alias savedReturn r7
alias pinPresent r8
alias jumpOffset r9

move phase 0
jal allOff

main:
jal readSwitch
ble systemOn 0 systemOff

move nameIndex phase
move lightState 1
jal writeLight

sub offIndex phase BeamWidth
add offIndex offIndex LightCount
mod offIndex offIndex LightCount
move nameIndex offIndex
move lightState 0
jal writeLight

add phase phase 1
mod phase phase LightCount
sleep StepDelay
j main

systemOff:
jal allOff
sleep 1
j main

readSwitch:
move systemOn 0
sdse pinPresent switchPin
beq pinPresent 0 namedSwitch
bdnvl switchPin Setting namedSwitch
l systemOn switchPin Setting
sgtz systemOn systemOn
j ra

namedSwitch:
lbn switchState switchType switchName Setting Maximum
sgtz switchState switchState
lbn leverState leverType switchName Setting Maximum
sgtz leverState leverState
max systemOn switchState leverState
j ra

allOff:
move savedReturn ra
move lightState 0
move nameIndex 0
allOffLoop:
jal writeLight
add nameIndex nameIndex 1
blt nameIndex LightCount allOffLoop
j savedReturn

writeLight:
mul jumpOffset nameIndex 2
add jumpOffset jumpOffset 1
jr jumpOffset
sbn lightType HASH("LIGHT_01") On lightState
j ra
sbn lightType HASH("LIGHT_02") On lightState
j ra
sbn lightType HASH("LIGHT_03") On lightState
j ra
sbn lightType HASH("LIGHT_04") On lightState
j ra
sbn lightType HASH("LIGHT_05") On lightState
j ra
sbn lightType HASH("LIGHT_06") On lightState
j ra
sbn lightType HASH("LIGHT_07") On lightState
j ra
sbn lightType HASH("LIGHT_08") On lightState
j ra
sbn lightType HASH("LIGHT_09") On lightState
j ra
sbn lightType HASH("LIGHT_10") On lightState
j ra
sbn lightType HASH("LIGHT_11") On lightState
j ra
sbn lightType HASH("LIGHT_12") On lightState
j ra
sbn lightType HASH("LIGHT_13") On lightState
j ra
sbn lightType HASH("LIGHT_14") On lightState
j ra
sbn lightType HASH("LIGHT_15") On lightState
j ra
sbn lightType HASH("LIGHT_16") On lightState
j ra
sbn lightType HASH("LIGHT_17") On lightState
j ra
sbn lightType HASH("LIGHT_18") On lightState
j ra
sbn lightType HASH("LIGHT_19") On lightState
j ra
sbn lightType HASH("LIGHT_20") On lightState
j ra
