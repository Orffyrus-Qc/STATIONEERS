# Default to ON on every IC boot before entering the timed cycle.
sb HASH("StructureGrowLight") On 1             # Turn grow lights ON
sb HASH("StructureHydroponicsStation") On 1    # Turn hydroponics stations ON

start:
sleep 840                            # 14 minutes (840 seconds)
sb HASH("StructureGrowLight") On 0             # Turn grow lights OFF
sb HASH("StructureHydroponicsStation") On 0    # Turn hydroponics stations OFF
sleep 360                            # 6 minutes (360 seconds)
sb HASH("StructureGrowLight") On 1             # Turn grow lights ON
sb HASH("StructureHydroponicsStation") On 1    # Turn hydroponics stations ON
j start
