alias rGrowStation r0
alias rTarget r1
alias rIdle r2
alias rError r3
alias rOccupied r4
alias rMature r5
alias rSeeding r6
alias rDamage r7
alias rDidPickup r8
define LARRE_TYPE HASH("StructureLarreDockHydroponics")
define LARRE_NAME HASH("LArRE")
define FIRST_GROW_STATION 0
define LAST_GROW_STATION 15
define SEED_IMPORT_STATION 16
define SEED_EXPORT_STATION 17
define CROPS_EXPORT_STATION 18
define SAMPLE_SLOT 255
define ACTION_SETTLE_SECONDS 2
define LOOP_PAUSE_SECONDS 10
init:
sbn LARRE_TYPE LARRE_NAME On 1
sbn LARRE_TYPE LARRE_NAME Activate 0
main:
move rGrowStation FIRST_GROW_STATION
scanGrowStation:
move rTarget rGrowStation
jal goToTarget
jal inspectTray
beqz rOccupied plantEmptyTray
bge rDamage 1 clearDeadPlant
bgt rSeeding 0 harvestSeed
j nextGrowStation
plantEmptyTray:
jal pickupSeed
beqz rDidPickup nextGrowStation
move rTarget rGrowStation
jal goToTarget
jal pulseClawAndWait
j nextGrowStation
harvestSeed:
jal pulseClawAndWait
move rTarget SEED_EXPORT_STATION
jal dropToImportBin
move rTarget rGrowStation
jal goToTarget
jal inspectTray
bnez rMature harvestCrop
j nextGrowStation
harvestCrop:
jal pulseClawAndWait
move rTarget CROPS_EXPORT_STATION
jal dropToImportBin
move rTarget rGrowStation
jal goToTarget
jal inspectTray
beqz rOccupied plantEmptyTray
j nextGrowStation
clearDeadPlant:
jal pulseClawAndWait
move rTarget CROPS_EXPORT_STATION
jal dropToImportBin
move rTarget rGrowStation
jal goToTarget
jal inspectTray
beqz rOccupied plantEmptyTray
j nextGrowStation
nextGrowStation:
add rGrowStation rGrowStation 1
ble rGrowStation LAST_GROW_STATION scanGrowStation
sleep LOOP_PAUSE_SECONDS
j main
pickupSeed:
push ra
move rDidPickup 0
move rTarget SEED_IMPORT_STATION
jal goToTarget
lbns rOccupied LARRE_TYPE LARRE_NAME SAMPLE_SLOT Occupied Maximum
beqz rOccupied pickupSeedDone
jal pulseClawAndWait
move rDidPickup 1
pickupSeedDone:
pop ra
j ra
dropToImportBin:
push ra
jal goToTarget
waitDropBinClear:
yield
lbns rOccupied LARRE_TYPE LARRE_NAME SAMPLE_SLOT Occupied Maximum
bnez rOccupied waitDropBinClear
jal pulseClawAndWait
pop ra
j ra
goToTarget:
push ra
sbn LARRE_TYPE LARRE_NAME Setting rTarget
jal waitForLarry
pop ra
j ra
waitForLarry:
yield
lbn rError LARRE_TYPE LARRE_NAME Error Maximum
bnez rError waitForClear
lbn rIdle LARRE_TYPE LARRE_NAME Idle Maximum
beqz rIdle waitForLarry
j ra
waitForClear:
sbn LARRE_TYPE LARRE_NAME Activate 0
yield
lbn rError LARRE_TYPE LARRE_NAME Error Maximum
bnez rError waitForClear
j waitForLarry
inspectTray:
lbns rOccupied LARRE_TYPE LARRE_NAME SAMPLE_SLOT Occupied Maximum
lbns rDamage LARRE_TYPE LARRE_NAME SAMPLE_SLOT Damage Maximum
lbns rMature LARRE_TYPE LARRE_NAME SAMPLE_SLOT Mature Maximum
lbns rSeeding LARRE_TYPE LARRE_NAME SAMPLE_SLOT Seeding Maximum
j ra
pulseClawAndWait:
push ra
sbn LARRE_TYPE LARRE_NAME Activate 1
yield
sbn LARRE_TYPE LARRE_NAME Activate 0
sleep ACTION_SETTLE_SECONDS
jal waitForLarry
pop ra
j ra
