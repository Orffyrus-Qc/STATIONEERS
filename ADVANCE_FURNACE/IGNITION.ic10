# Required labels:
# ADVANCED_FURNACE = StructureAdvancedFurnace
# START_STOP_SWITCH = StructureLogicSwitch2 or ModularDeviceBigLever
# ING = ModularDeviceBigLever
# IGNITION = ModularDeviceLabelDiode3
# Pulses furnace ignition below 270 K while either start control is on.
# Hysteresis keeps ignition active until temperature rises above 275 K.
# START_STOP_SWITCH and ING off stops furnace ignition.
# IGNITION is green when either start control is on, red when both are off.
define FURNACE_TYPE HASH("StructureAdvancedFurnace")
define FURNACE_NAME HASH("ADVANCED_FURNACE")
define SWITCH_TYPE HASH("StructureLogicSwitch2")
define LEVER_TYPE HASH("ModularDeviceBigLever")
define SWITCH_NAME HASH("START_STOP_SWITCH")
define BUTTON_NAME HASH("ING")
define DISPLAY_TYPE HASH("ModularDeviceLabelDiode3")
define DISPLAY_NAME HASH("IGNITION")
define GREEN 2
define RED 4

define ACTIVATE_BELOW_K 270
define HYSTERESIS_K 5

start:
move r1 0
move r3 ACTIVATE_BELOW_K
add r3 r3 HYSTERESIS_K

loop:
lbn r4 SWITCH_TYPE SWITCH_NAME Setting Average
bnan r4 switch_missing
sgtz r4 r4
j read_lever
switch_missing:
move r4 0
read_lever:
lbn r5 LEVER_TYPE SWITCH_NAME Open Maximum
bnan r5 lever_missing
sgtz r5 r5
j read_button
lever_missing:
move r5 0
read_button:
lbn r6 LEVER_TYPE BUTTON_NAME Open Maximum
bnan r6 button_missing
sgtz r6 r6
j check_enabled
button_missing:
move r6 0
check_enabled:
max r4 r4 r5
max r4 r4 r6

sbn DISPLAY_TYPE DISPLAY_NAME On 1
select r5 r4 GREEN RED
sbn DISPLAY_TYPE DISPLAY_NAME Color r5
beqz r4 ignition_off
lbn r0 FURNACE_TYPE FURNACE_NAME Temperature Average
beqz r1 maybe_activate

maybe_deactivate:
sgt r2 r0 r3
beqz r2 pulse_ignition
move r1 0
j ignition_off

maybe_activate:
slt r2 r0 ACTIVATE_BELOW_K
beqz r2 ignition_off
move r1 1

pulse_ignition:
sbn FURNACE_TYPE FURNACE_NAME Activate 1
yield
sbn FURNACE_TYPE FURNACE_NAME Activate 0
yield
j loop

ignition_off:
move r1 0
sbn FURNACE_TYPE FURNACE_NAME Activate 0
yield
j loop
